---
import Layout from '../layouts/Layout.astro';
import PaperRow from './PaperRow.astro';
import { getPapers, volumesDescending, papersInVolume } from '../lib/content';
import { volumeLabel, volumeRoman } from '../data/site';
import type { Language } from '../data/editions';

interface Props { lang: Language; }
const { lang } = Astro.props;
const pt = lang === 'pt';
const papers = await getPapers();
const volumes = volumesDescending(papers);
const portugueseVolumes: Record<number, string> = { 1: 'Arquitetura', 2: 'Inteligência Organizacional' };
const label = (volume: number) => pt
  ? `Volume ${volumeRoman(volume)}${portugueseVolumes[volume] ? ` — ${portugueseVolumes[volume]}` : ''}`
  : volumeLabel(volume);
---

<Layout
  title={pt ? 'Ensaios' : 'Papers'}
  lang={lang}
  description={pt ? 'A coleção de ensaios de Inês Gavinho. Originais em inglês e edições portuguesas revistas.' : 'The collected essays of Inês Gavinho. English originals and revised Portuguese editions.'}
  canonicalPath={pt ? '/pt/papers' : '/papers'}
  alternateLanguages={[{ lang: 'pt', href: '/pt/papers' }, { lang: 'en', href: '/papers' }]}
>
  <div class="papers-page">
    <h1>{pt ? 'Ensaios' : 'Papers'}</h1>
    <p class="index-intro">{pt
      ? 'Cada ensaio parte de uma pergunta e propõe uma distinção. A coleção cresce por acumulação.'
      : 'Each essay begins with a question and proposes a distinction. The collection grows by accumulation.'}</p>
    <p class="edition-note">{pt
      ? 'As edições portuguesas revistas desenvolvem os ensaios originais em inglês; não são traduções literais. Os originais mantêm as suas datas de publicação.'
      : 'The revised Portuguese editions develop the original English essays; they are not literal translations. The originals retain their publication dates.'}</p>
    {volumes.map((volume) => (
      <section class="volume-group" aria-labelledby={`volume-${volume}`}>
        <h2 class="index-kicker" id={`volume-${volume}`}>{label(volume)}</h2>
        <div class="index-list">{papersInVolume(papers, volume).map((paper) => <PaperRow paper={paper} lang={lang} />)}</div>
      </section>
    ))}
  </div>
</Layout>
