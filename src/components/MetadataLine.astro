---
import { conceptSlug } from '../data/site';

interface Props {
  // discrete textual parts, joined with a thin separator
  parts?: (string | undefined)[];
  // optional concept list rendered as links after the parts
  concepts?: string[];
  conceptSeparator?: string;
}

const { parts = [], concepts = [], conceptSeparator = ' / ' } = Astro.props;
const items = parts.filter(Boolean) as string[];
---

<p class="meta-line">
  {
    items.map((part, i) => (
      <>
        {i > 0 && <span class="sep">·</span>}
        {part}
      </>
    ))
  }
  {
    concepts.length > 0 && (
      <>
        {items.length > 0 && <span class="sep">·</span>}
        {concepts.map((c, i) => (
          <>
            {i > 0 && conceptSeparator}
            <a href={`/index/${conceptSlug(c)}`}>{c}</a>
          </>
        ))}
      </>
    )
  }
</p>
