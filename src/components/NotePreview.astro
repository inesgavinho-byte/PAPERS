---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  note: CollectionEntry<'notes'>;
  // compact = single-line row (used on homepage); otherwise show excerpt + concepts
  compact?: boolean;
}

const { note, compact = false } = Astro.props;
const { title, published, excerpt, concepts } = note.data;
const href = `/notes/${note.id}`;
---

{
  compact ? (
    <a class="note-row" href={href}>
      <span class="date">{formatDate(published)}</span>
      <span class="note-title">{title}</span>
    </a>
  ) : (
    <article>
      <a class="note-row" href={href}>
        <span class="date">{formatDate(published)}</span>
        <span class="note-title">{title}</span>
      </a>
      {excerpt && <p class="muted" style="margin:0.4rem 0 0 9.5rem; max-width:46ch">{excerpt}</p>}
    </article>
  )
}
