---
import type { CollectionEntry } from 'astro:content';
import Distinction from './Distinction.astro';
import { issueNumber } from '../lib/format';

interface Props {
  paper: CollectionEntry<'papers'>;
}

const { paper } = Astro.props;
const { issue, title, centralDistinction } = paper.data;
const href = `/papers/${paper.id}`;
---

<a class="paper-row" href={href}>
  <span class="issue">Issue {issueNumber(issue)}</span>
  <span class="paper-row-body">
    <span class="paper-row-title">{title}</span>
    <span class="paper-row-distinction">
      <Distinction value={centralDistinction} size="small" />
    </span>
  </span>
</a>
