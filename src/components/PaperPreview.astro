---
import type { CollectionEntry } from 'astro:content';
import MetadataLine from './MetadataLine.astro';
import { formatDate, paperNumber } from '../lib/format';

interface Props {
  paper: CollectionEntry<'papers'>;
  showAbstract?: boolean;
}

const { paper, showAbstract = true } = Astro.props;
const { number, title, abstract, published, readingTime, version, concepts } = paper.data;
const href = `/papers/${paper.id}`;
---

<article class="paper-preview">
  <div class="num">Paper {paperNumber(number)}</div>
  <h3><a href={href} style="border:0">{title}</a></h3>
  {showAbstract && <p class="abstract">{abstract}</p>}
  <MetadataLine
    parts={[readingTime, formatDate(published), `v${version}`]}
    concepts={concepts}
  />
  <p style="margin-top:0.8rem"><a class="read-more" href={href} style="border:0">Read →</a></p>
</article>
