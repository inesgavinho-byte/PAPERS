---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ConceptList from '../../components/ConceptList.astro';
import { getNotes } from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, published, concepts } = note.data;
---

<Layout
  title={title}
  description={note.data.excerpt ?? title}
  canonicalPath={`/notes/${note.id}`}
  ogType="article"
>
  <article class="wrap article">
    <div class="read">
      <p class="meta-line">{formatDate(published)} · Note</p>
      <h1 class="paper-title" style="margin-top:0.4rem">{title}</h1>

      <hr class="rule" />

      <div class="prose">
        <Content />
      </div>

      {
        concepts.length > 0 && (
          <>
            <hr class="rule" />
            <div class="related">
              <div>
                <p class="group-title">Concepts</p>
                <ConceptList concepts={concepts} variant="inline" />
              </div>
            </div>
          </>
        )
      }

      <p style="margin-top:2rem"><a class="read-more" href="/notes" style="border:0">← All notes</a></p>
    </div>
  </article>
</Layout>
