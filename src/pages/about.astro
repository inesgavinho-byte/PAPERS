---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="About"
  description={site.description}
  canonicalPath="/about"
>
  <section class="wrap article">
    <div class="read">
      <h1 class="paper-title">About</h1>
      <div class="prose" style="margin-top:1.6rem">
        <p>
          PAPERS is an editorial institution. It publishes theses on
          architecture, time, attention and the human condition — work intended
          to remain relevant long after the moment that produced it.
        </p>
        <p>
          Each Paper introduces a single conceptual distinction. The collection
          grows slowly, by addition, over years. The ambition is not to publish
          often, but to publish work that deserves to remain.
        </p>
        <p>It is edited by Inês Gavinho.</p>
      </div>
    </div>
  </section>
</Layout>
