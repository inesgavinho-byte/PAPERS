---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About"
  description="PAPERS is an editorial project by Inês Gavinho, dedicated to ideas on architecture, organisations, hospitality, knowledge and systems."
  canonicalPath="/about"
>
  <section class="wrap article">
    <div class="read">
      <h1 class="paper-title">About</h1>
      <div class="prose" style="margin-top:1.4rem">
        <p>
          PAPERS is an editorial project by Inês Gavinho, dedicated to ideas on
          architecture, organisations, hospitality, knowledge and systems.
        </p>
        <p>
          It exists to explore what remains: the buildings, companies,
          institutions, memories and forms of intelligence that continue to
          create value beyond their original moment.
        </p>
      </div>
    </div>
  </section>
</Layout>
