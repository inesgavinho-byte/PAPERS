---
import Layout from '../../layouts/Layout.astro';
import PaperRow from '../../components/PaperRow.astro';
import { getPapers, volumesDescending, papersInVolume } from '../../lib/content';
import { volumeLabel } from '../../data/site';

const papers = await getPapers();
const volumes = volumesDescending(papers);
---

<Layout
  title="Papers"
  description="The collected Papers of PAPERS — theses on architecture, time, attention and the human condition."
  canonicalPath="/papers"
>
  <div class="papers-page">
    <h1>Papers</h1>
    <p class="index-intro">
      Each Paper is a thesis. Each introduces a single conceptual distinction.
      The collection grows slowly, by addition.
    </p>

    {
      volumes.map((volume) => (
        <section class="volume-group">
          <p class="index-kicker">{volumeLabel(volume)}</p>
          <div class="index-list">
            {papersInVolume(papers, volume).map((paper) => (
              <PaperRow paper={paper} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
