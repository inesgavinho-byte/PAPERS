---
import Layout from '../../layouts/Layout.astro';
import PaperPreview from '../../components/PaperPreview.astro';
import { getPapers } from '../../lib/content';

const papers = await getPapers();
---

<Layout
  title="Papers"
  description="The collected Papers of PAPERS — theses on architecture, time, attention and the human condition."
  canonicalPath="/papers"
>
  <div class="index-page">
    <h1>Papers</h1>
    <p class="index-intro">
      Each Paper is a thesis. Each introduces a single conceptual distinction.
      The collection grows slowly, by addition.
    </p>
    {papers.map((paper) => <PaperPreview paper={paper} />)}
  </div>
</Layout>
