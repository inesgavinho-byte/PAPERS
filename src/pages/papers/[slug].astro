---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Distinction from '../../components/Distinction.astro';
import {
  getPapers,
  getPrinciples,
  relatedPapers,
  principlesForPaper,
} from '../../lib/content';
import { formatDate, issueNumber } from '../../lib/format';
import { slugify } from '../../data/site';

export async function getStaticPaths() {
  const papers = await getPapers();
  const principles = await getPrinciples();
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper, papers, principles },
  }));
}

const { paper, papers, principles } = Astro.props;
const { Content } = await render(paper);

const {
  issue,
  title,
  centralDistinction,
  question,
  abstract,
  readingTime,
  published,
  ideas,
  genealogy,
} = paper.data;

const related = relatedPapers(paper, papers).slice(0, 3);
const relPrinciples = principlesForPaper(paper, principles);
const num = issueNumber(issue);
---

<Layout title={title} description={abstract} canonicalPath={`/papers/${paper.id}`} ogType="article">
  <article>
    <!-- Title page -->
    <header class="paper-entry">
      <p class="issue-number">Issue {num}</p>
      <h1>{title}</h1>

      {
        question && (
          <div class="paper-entry-section">
            <p class="paper-entry-label">Question</p>
            <p class="paper-question">{question}</p>
          </div>
        )
      }

      <div class="paper-entry-section">
        <p class="paper-entry-label">Central Distinction</p>
        <Distinction value={centralDistinction} variant="stacked" />
      </div>

      <div class="paper-entry-section">
        <p class="paper-entry-label">Abstract</p>
        <p class="paper-abstract">{abstract}</p>
        <p class="paper-metadata">{formatDate(published)} · {readingTime}</p>
      </div>
    </header>

    <!-- Reading: rail · essay · distinction -->
    <div class="paper-reading">
      <aside class="reading-rail">
        <div class="rail-section">
          <strong>Issue {num}</strong>
        </div>
        <div class="rail-section">
          <span class="rail-label">Published</span>
          {formatDate(published)}
        </div>
        <div class="rail-section">
          <span class="rail-label">Reading time</span>
          {readingTime}
        </div>
        {
          ideas.length > 0 && (
            <div class="rail-section">
              <span class="rail-label">Ideas</span>
              <ul class="rail-links">
                {ideas.map((i) => (
                  <li><a href={`/ideas/${slugify(i)}`}>{i}</a></li>
                ))}
              </ul>
            </div>
          )
        }
        {
          relPrinciples.length > 0 && (
            <div class="rail-section">
              <span class="rail-label">Principles</span>
              <ul class="rail-links">
                {relPrinciples.map((pr) => (
                  <li><a href={`/principles/${pr.id}`}>{pr.data.title}</a></li>
                ))}
              </ul>
            </div>
          )
        }
        {
          genealogy.length > 0 && (
            <div class="rail-section">
              <span class="rail-label">Genealogy</span>
              <ul class="rail-genealogy">
                {genealogy.map((g) => <li>{g}</li>)}
              </ul>
            </div>
          )
        }
      </aside>

      <div class="prose">
        <Content />
      </div>

      <aside class="reading-distinction">
        <p class="label">Central Distinction</p>
        <p class="text"><Distinction value={centralDistinction} variant="inline" /></p>
      </aside>
    </div>

    <!-- Relations -->
    {
      (related.length > 0 || relPrinciples.length > 0 || ideas.length > 0) && (
        <footer class="paper-footer">
          <hr class="rule" />
          {related.length > 0 && (
            <div class="related-group">
              <p class="group-title">Related Papers</p>
              <ul>
                {related.map((p) => (
                  <li>
                    <a href={`/papers/${p.id}`}>
                      Issue {issueNumber(p.data.issue)} — {p.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {relPrinciples.length > 0 && (
            <div class="related-group">
              <p class="group-title">Related Principles</p>
              <ul>
                {relPrinciples.map((pr) => (
                  <li><a href={`/principles/${pr.id}`}>{pr.data.title}</a></li>
                ))}
              </ul>
            </div>
          )}
          {ideas.length > 0 && (
            <div class="related-group">
              <p class="group-title">Related Ideas</p>
              <ul>
                {ideas.map((i) => (
                  <li><a href={`/ideas/${slugify(i)}`}>{i}</a></li>
                ))}
              </ul>
            </div>
          )}
        </footer>
      )
    }
  </article>
</Layout>
