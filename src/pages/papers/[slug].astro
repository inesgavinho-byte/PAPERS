---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Distinction from '../../components/Distinction.astro';
import {
  getPapers,
  getPrinciples,
  relatedPapers,
  principlesForPaper,
} from '../../lib/content';
import { formatDate, issueNumber, estimateReadingTime } from '../../lib/format';
import { portugueseEditions } from '../../data/editions';
import { slugify, volumeNames } from '../../data/site';

export async function getStaticPaths() {
  const papers = await getPapers();
  const principles = await getPrinciples();
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper, papers, principles },
  }));
}

const { paper, papers, principles } = Astro.props;
const { Content } = await render(paper);

const {
  issue,
  volume,
  title,
  centralDistinction,
  question,
  abstract,
  published,
  ideas,
  genealogy,
} = paper.data;

const readingTime = estimateReadingTime(paper.body);
const revisedEdition = portugueseEditions[paper.id];
const related = relatedPapers(paper, papers).slice(0, 3);
const relPrinciples = principlesForPaper(paper, principles);
const num = issueNumber(issue);
// Reference label: domain name + zero-padded number, e.g. "Organisational Intelligence · 001".
const reference = `${volumeNames[volume] ?? `Volume ${volume}`} · ${num}`;
---

<Layout title={title} description={abstract} canonicalPath={`/papers/${paper.id}`} ogType="article" ogImage={`/og/${paper.id}.png`}>
  <article>
    <div class="edition-back"><a href="/papers">← All papers</a></div>
    {revisedEdition && (
      <aside class="edition-notice">
        <p>This is the original English publication. A revised Portuguese edition is also available.</p>
        <a href={`/pt/papers/${paper.id}`} lang="pt" hreflang="pt">Ler a edição portuguesa revista →</a>
      </aside>
    )}
    <!-- Title page -->
    <header class="paper-entry">
      <p class="issue-number">{reference}</p>
      <h1>{title}</h1>

      {
        question && (
          <div class="paper-entry-section">
            <p class="paper-entry-label">Question</p>
            <p class="paper-question">{question}</p>
          </div>
        )
      }

      <div class="paper-entry-section paper-entry-section--center">
        <p class="paper-entry-label">Central Distinction</p>
        <Distinction value={centralDistinction} variant="stacked" />
      </div>

      <div class="paper-entry-section">
        <p class="paper-entry-label">Abstract</p>
        <p class="paper-abstract">{abstract}</p>
        <p class="paper-metadata">Inês Gavinho · {formatDate(published)} · {readingTime} estimated reading</p>
      </div>
    </header>

    <!-- Reading: rail · essay · distinction -->
    <div class="paper-reading">
      <aside class="reading-rail">
        <div class="rail-section">
          <strong>{reference}</strong>
        </div>
        <div class="rail-section">
          <span class="rail-label">Published</span>
          {formatDate(published)}
        </div>
        <div class="rail-section">
          <span class="rail-label">Estimated reading time</span>
          {readingTime}
        </div>
        {
          ideas.length > 0 && (
            <div class="rail-section">
              <span class="rail-label">Ideas</span>
              <ul class="rail-links">
                {ideas.map((i) => (
                  <li><a href={`/ideas/${slugify(i)}`}>{i}</a></li>
                ))}
              </ul>
            </div>
          )
        }
        {
          relPrinciples.length > 0 && (
            <div class="rail-section">
              <span class="rail-label">Principles</span>
              <ul class="rail-links">
                {relPrinciples.map((pr) => (
                  <li><a href={`/principles/${pr.id}`}>{pr.data.title}</a></li>
                ))}
              </ul>
            </div>
          )
        }
        {
          genealogy.length > 0 && (
            <div class="rail-section">
              <span class="rail-label">Genealogy</span>
              <ul class="rail-genealogy">
                {genealogy.map((g) => <li>{g}</li>)}
              </ul>
            </div>
          )
        }
      </aside>

      <div class="prose">
        <Content />
      </div>

      <aside class="reading-distinction">
        <p class="label">Central Distinction</p>
        <p class="text"><Distinction value={centralDistinction} variant="inline" /></p>
      </aside>
    </div>

    <!-- Relations -->
    {
      (related.length > 0 || relPrinciples.length > 0 || ideas.length > 0) && (
        <footer class="paper-footer">
          <hr class="rule" />
          {related.length > 0 && (
            <div class="related-group">
              <p class="group-title">Related Papers</p>
              <ul>
                {related.map((p) => (
                  <li>
                    <a href={`/papers/${p.id}`}>
                      Issue {issueNumber(p.data.issue)} — {p.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {relPrinciples.length > 0 && (
            <div class="related-group">
              <p class="group-title">Related Principles</p>
              <ul>
                {relPrinciples.map((pr) => (
                  <li><a href={`/principles/${pr.id}`}>{pr.data.title}</a></li>
                ))}
              </ul>
            </div>
          )}
          {ideas.length > 0 && (
            <div class="related-group">
              <p class="group-title">Related Ideas</p>
              <ul>
                {ideas.map((i) => (
                  <li><a href={`/ideas/${slugify(i)}`}>{i}</a></li>
                ))}
              </ul>
            </div>
          )}
        </footer>
      )
    }
  </article>
</Layout>
