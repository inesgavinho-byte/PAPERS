---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Distinction from '../../components/Distinction.astro';
import IdeaList from '../../components/IdeaList.astro';
import {
  getPapers,
  getPrinciples,
  relatedPapers,
  principlesForPaper,
} from '../../lib/content';
import { formatDate, issueNumber } from '../../lib/format';

export async function getStaticPaths() {
  const papers = await getPapers();
  const principles = await getPrinciples();
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper, papers, principles },
  }));
}

const { paper, papers, principles } = Astro.props;
const { Content } = await render(paper);

const {
  issue,
  title,
  centralDistinction,
  abstract,
  readingTime,
  published,
  ideas,
  genealogy,
} = paper.data;

const related = relatedPapers(paper, papers).slice(0, 3);
const relPrinciples = principlesForPaper(paper, principles);
---

<Layout title={title} description={abstract} canonicalPath={`/papers/${paper.id}`} ogType="article">
  <article class="wrap article">
    <div class="read">
      <header class="paper-head">
        <p class="issue-line">Issue {issueNumber(issue)}</p>
        <h1 class="paper-title">{title}</h1>

        <div class="central-distinction">
          <p class="label">Central Distinction</p>
          <Distinction value={centralDistinction} size="large" />
        </div>

        <p class="abstract">{abstract}</p>

        <dl class="paper-meta">
          <div>
            <dt>Published</dt>
            <dd>{formatDate(published)}</dd>
          </div>
          <div>
            <dt>Reading time</dt>
            <dd>{readingTime}</dd>
          </div>
          {
            ideas.length > 0 && (
              <div>
                <dt>Ideas</dt>
                <dd><IdeaList ideas={ideas} variant="inline" /></dd>
              </div>
            )
          }
          {
            relPrinciples.length > 0 && (
              <div>
                <dt>Principles</dt>
                <dd>
                  <ul class="meta-links">
                    {relPrinciples.map((pr) => (
                      <li><a href={`/principles/${pr.id}`}>{pr.data.title}</a></li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            genealogy.length > 0 && (
              <div class="genealogy">
                <dt>Genealogy</dt>
                <dd>
                  <ul>
                    {genealogy.map((g) => <li>{g}</li>)}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </header>

      <hr class="rule" />

      <div class="prose">
        <Content />
      </div>

      {
        (related.length > 0 || relPrinciples.length > 0 || ideas.length > 0) && (
          <footer class="paper-foot">
            <hr class="rule" />
            <div class="related">
              {related.length > 0 && (
                <div>
                  <p class="group-title">Related Papers</p>
                  <ul>
                    {related.map((p) => (
                      <li>
                        <a href={`/papers/${p.id}`}>
                          Issue {issueNumber(p.data.issue)} — {p.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {relPrinciples.length > 0 && (
                <div>
                  <p class="group-title">Related Principles</p>
                  <ul>
                    {relPrinciples.map((pr) => (
                      <li><a href={`/principles/${pr.id}`}>{pr.data.title}</a></li>
                    ))}
                  </ul>
                </div>
              )}

              {ideas.length > 0 && (
                <div>
                  <p class="group-title">Related Ideas</p>
                  <IdeaList ideas={ideas} variant="inline" />
                </div>
              )}
            </div>
          </footer>
        )
      }
    </div>
  </article>
</Layout>
