---
import Layout from '../layouts/Layout.astro';
import { getPapers, getCurrentPaper } from '../lib/content';
import { site } from '../data/site';
import { issueNumber } from '../lib/format';

const papers = await getPapers();
const current = await getCurrentPaper();

// The visitor arrives inside the idea: lead with the current thesis.
const thesisRaw = current?.data.thesis ?? site.purpose;
const thesisLines = thesisRaw.split(/(?<=\.)\s+/).filter(Boolean);

const note =
  'An independent publication investigating architecture, organisations and the human condition through original essays.';
---

<Layout nav="cover" canonicalPath="/">
  <div class="edition">
    <!-- Section 1 — the thesis confronts the visitor -->
    <section class="lead">
      <p class="lead-thesis">
        {thesisLines.map((line) => <span class="line">{line}</span>)}
      </p>
      {
        current && (
          <p class="lead-cta">
            <a href={`/papers/${current.id}`}>Read Paper {issueNumber(current.data.issue)} →</a>
          </p>
        )
      }
    </section>

    <!-- Section 2 — the publication, revealed afterwards, placed aside -->
    <section class="colophon">
      <h1 class="colophon-title">{site.name}</h1>
      <p class="colophon-byline">{site.byline}</p>
      <p class="colophon-note">{note}</p>
    </section>

    <!-- Section 3 — a printed contents page -->
    <section class="toc">
      <p class="section-kicker">Collected Papers</p>
      <ol class="toc-list">
        {
          papers.map((paper) => (
            <li class="toc-entry">
              <a href={`/papers/${paper.id}`}>
                <span class="toc-num">Issue {issueNumber(paper.data.issue)}</span>
                <span class="toc-title">{paper.data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>
