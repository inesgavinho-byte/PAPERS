---
import Layout from '../layouts/Layout.astro';
import { getPapers, getCurrentPaper } from '../lib/content';
import { site } from '../data/site';
import { issueNumber } from '../lib/format';

const papers = await getPapers();
const current = await getCurrentPaper();

// Lead with the current Paper's thesis; break on sentences so it composes
// into the dominant multi-line statement of the cover.
const thesisRaw = current?.data.thesis ?? site.purpose;
const thesisLines = thesisRaw.split(/(?<=\.)\s+/).filter(Boolean);
---

<Layout nav="cover" canonicalPath="/">
  <div class="cover">
    <div class="cover-inner">
      <h1 class="cover-title">{site.name}</h1>
      <p class="cover-byline">{site.byline}</p>

      <hr class="cover-shortrule" />

      <p class="cover-thesis">
        {thesisLines.map((line) => <span class="line">{line}</span>)}
      </p>

      {
        current && (
          <div class="cover-current">
            <p class="ci-issue">Issue {issueNumber(current.data.issue)}</p>
            <p class="ci-title">{current.data.title}</p>
            <a class="text-link" href={`/papers/${current.id}`}>Read →</a>
          </div>
        )
      }

      <section class="cover-contents">
        <p class="section-kicker">Collected Papers</p>
        <div class="contents-table">
          {
            papers.map((paper) => (
              <a class="contents-row" href={`/papers/${paper.id}`}>
                <span class="ci">Issue {issueNumber(paper.data.issue)}</span>
                <span class="ct">{paper.data.title}</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
