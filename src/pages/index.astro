---
import Layout from '../layouts/Layout.astro';
import PaperRow from '../components/PaperRow.astro';
import { getPapers, getCurrentPaper, maxVolume, papersInVolume } from '../lib/content';
import { disciplineQuestion, tagline } from '../data/site';
import { issueNumber } from '../lib/format';

const papers = await getPapers();
const current = await getCurrentPaper();
const volume = maxVolume(papers);
const volumePapers = papersInVolume(papers, volume);
---

<Layout canonicalPath="/">
  <div class="frontispiece">
    <section class="hero">
      <div class="hero-lead">
        <h1 class="hero-question">{disciplineQuestion}</h1>
        <hr class="hero-rule" />
        <p class="hero-tagline">{tagline}</p>
        {
          current && (
            <a class="hero-cta" href={`/papers/${current.id}`}>
              Read Paper {issueNumber(current.data.issue)} →
            </a>
          )
        }
      </div>

      {
        current && (
          <a class="hero-panel" href={`/papers/${current.id}`}>
            <span class="panel-label">Current Investigation</span>
            <span class="panel-issue">Issue {issueNumber(current.data.issue)}</span>
            <span class="panel-title">{current.data.title}</span>
            <span class="panel-distinction">{current.data.centralDistinction}</span>
            <hr class="panel-rule" />
            <span class="panel-question">{current.data.question}</span>
          </a>
        )
      }
    </section>

    <section class="index">
      <div class="index-head">
        <div>
          <p class="index-kicker">Collected Papers</p>
          <p class="index-volume">Volume {volume}</p>
        </div>
        <a class="index-seeall" href="/papers">See all papers →</a>
      </div>

      <div class="index-list">
        {volumePapers.map((paper) => <PaperRow paper={paper} />)}
      </div>
    </section>
  </div>
</Layout>
