---
import Layout from '../layouts/Layout.astro';
import Distinction from '../components/Distinction.astro';
import IdeaList from '../components/IdeaList.astro';
import { getPapers, getCurrentPaper } from '../lib/content';
import { site, featuredIdeas } from '../data/site';
import { issueNumber } from '../lib/format';

const papers = await getPapers();
const current = await getCurrentPaper();
---

<Layout canonicalPath="/">
  <div class="cover">
    <section class="masthead">
      <h1 class="masthead-title">{site.name}</h1>
      <p class="masthead-byline">{site.byline}</p>
      <p class="masthead-purpose">{site.purpose}</p>
    </section>

    {
      current && (
        <section class="cover-block">
          <p class="label">Current Investigation</p>
          <a class="current" href={`/papers/${current.id}`}>
            <span class="issue">Issue {issueNumber(current.data.issue)}</span>
            <span class="current-title">{current.data.title}</span>
            <span class="current-distinction">
              <Distinction value={current.data.centralDistinction} size="medium" />
            </span>
            <span class="read-more">Read →</span>
          </a>
        </section>
      )
    }

    <section class="cover-block">
      <p class="label">Collected Papers</p>
      <ol class="contents">
        {
          papers.map((paper) => (
            <li>
              <a href={`/papers/${paper.id}`}>
                <span class="contents-issue">Issue {issueNumber(paper.data.issue)}</span>
                <span class="contents-title">{paper.data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cover-block">
      <p class="label">Ideas</p>
      <IdeaList ideas={featuredIdeas} />
    </section>

    <section class="cover-block cover-about">
      <p class="label">About</p>
      <p><a href="/about">{site.name} is an editorial institution. →</a></p>
    </section>
  </div>
</Layout>
