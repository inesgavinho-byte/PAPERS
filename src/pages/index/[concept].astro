---
import Layout from '../../layouts/Layout.astro';
import PaperPreview from '../../components/PaperPreview.astro';
import NotePreview from '../../components/NotePreview.astro';
import {
  getPapers,
  getNotes,
  papersForConcept,
  notesForConcept,
} from '../../lib/content';
import { concepts, conceptSlug } from '../../data/site';

export async function getStaticPaths() {
  const papers = await getPapers();
  const notes = await getNotes();

  return concepts.map((concept) => ({
    params: { concept: conceptSlug(concept) },
    props: {
      concept,
      papers: papersForConcept(papers, concept),
      notes: notesForConcept(notes, concept),
    },
  }));
}

const { concept, papers, notes } = Astro.props;
const empty = papers.length === 0 && notes.length === 0;
---

<Layout
  title={concept}
  description={`Papers and Notes on ${concept}.`}
  canonicalPath={`/index/${conceptSlug(concept)}`}
>
  <section class="wrap page-head">
    <p class="eyebrow">Concept</p>
    <h1>{concept}</h1>
    <p class="lede">
      {papers.length} {papers.length === 1 ? 'Paper' : 'Papers'} ·
      {notes.length} {notes.length === 1 ? 'Note' : 'Notes'}
    </p>
  </section>

  {
    empty && (
      <section class="wrap section">
        <p class="muted">Nothing here yet. This concept is waiting for its first piece.</p>
      </section>
    )
  }

  {
    papers.length > 0 && (
      <section class="wrap section">
        <p class="eyebrow section-title">Papers</p>
        <ul class="entry-list">
          {papers.map((paper) => (
            <li>
              <PaperPreview paper={paper} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    notes.length > 0 && (
      <section class="wrap section">
        <p class="eyebrow section-title">Notes</p>
        <ul class="entry-list">
          {notes.map((note) => (
            <li>
              <NotePreview note={note} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap section">
    <p><a class="read-more" href="/index" style="border:0">← Full index</a></p>
  </section>
</Layout>
