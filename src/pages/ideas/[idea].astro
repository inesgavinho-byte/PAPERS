---
import Layout from '../../layouts/Layout.astro';
import PaperPreview from '../../components/PaperPreview.astro';
import { getPapers, papersForIdea } from '../../lib/content';
import { ideas, slugify } from '../../data/site';

export async function getStaticPaths() {
  const papers = await getPapers();
  return ideas.map((idea) => ({
    params: { idea: slugify(idea.name) },
    props: { idea, papers: papersForIdea(papers, idea.name) },
  }));
}

const { idea, papers } = Astro.props;
---

<Layout title={idea.name} description={idea.gloss} canonicalPath={`/ideas/${slugify(idea.name)}`}>
  <div class="index-page">
    <p class="section-kicker">Idea</p>
    <h1>{idea.name}</h1>
    <p class="index-intro">{idea.gloss}</p>

    {
      papers.length > 0 ? (
        papers.map((paper) => <PaperPreview paper={paper} />)
      ) : (
        <p class="muted">No Papers have entered this territory yet.</p>
      )
    }

    <p style="margin-top:48px"><a class="text-link" href="/ideas">All Ideas</a></p>
  </div>
</Layout>
