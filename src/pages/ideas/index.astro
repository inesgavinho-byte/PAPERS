---
import Layout from '../../layouts/Layout.astro';
import { getPapers, ideaCount } from '../../lib/content';
import { ideas, slugify } from '../../data/site';

const papers = await getPapers();
const entries = ideas.map((idea) => ({
  ...idea,
  slug: slugify(idea.name),
  count: ideaCount(papers, idea.name),
}));
---

<Layout
  title="Ideas"
  description="The conceptual territories of PAPERS. Each Idea gathers every Paper that enters its terrain."
  canonicalPath="/ideas"
>
  <section class="wrap page-head">
    <h1>Ideas</h1>
    <p class="lede">
      Not tags — territories. Each Idea gathers every Paper that enters its
      terrain.
    </p>
  </section>

  <section class="wrap section">
    <ul class="idea-territories">
      {
        entries.map((e) => (
          <li>
            <a href={`/ideas/${e.slug}`}>
              <span class="idea-name">{e.name}</span>
              <span class="idea-gloss">{e.gloss}</span>
              <span class="idea-count">
                {e.count} {e.count === 1 ? 'Paper' : 'Papers'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
